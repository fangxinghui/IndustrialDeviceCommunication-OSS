<Project>
  <PropertyGroup>
    <!-- Keep the language version used by the source projects. -->
    <LangVersion>13</LangVersion>
    <NoWarn>$(NoWarn);CS0759;CS0757;CS0758</NoWarn>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/fangxinghui/IndustrialDeviceCommunication-OSS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright 2026 fangxinghui</Copyright>
  </PropertyGroup>
</Project>
